[
    {
        "name": "Pod without capabilities is denied",
        "template": "pod.yaml",
        "expected": "fail"
    },
    {
        "name": "Pod with drop ALL is allowed",
        "template": "pod-drop-all.yaml",
        "expected": "pass"
    },
    {
        "name": "Pod with drop NET_RAW is allowed",
        "template": "pod-for-list-items.yaml",
        "expected": "pass"
    },
    {
        "name": "Deployment without capabilities is denied",
        "template": "deployment.yaml",
        "expected": "fail"
    },
    {
        "name": "Deployment with drop ALL is allowed",
        "template": "deployment.yaml",
        "expected": "pass",
        "field_change_list": [
            "spec.template.spec.containers.[0].securityContext.capabilities.drop=[\"ALL\"]"
        ]
    },
    {
        "name": "CronJob without capabilities is denied",
        "template": "cronjob.yaml",
        "expected": "fail"
    },
    {
        "name": "CronJob with drop ALL is allowed",
        "template": "cronjob.yaml",
        "expected": "pass",
        "field_change_list": [
            "spec.jobTemplate.spec.template.spec.containers.[0].securityContext.capabilities.drop=[\"ALL\"]"
        ]
    },
    {
        "name": "Pod with initContainer lacking drop is denied",
        "template": "pod-drop-all.yaml",
        "expected": "fail",
        "field_change_list": [
            "spec.initContainers=[{\"name\":\"init\",\"image\":\"alpine\",\"command\":[\"sh\"]}]"
        ]
    },
    {
        "name": "Pod with drop ALL and add NET_RAW is denied",
        "template": "pod-drop-all.yaml",
        "expected": "fail",
        "field_change_list": [
            "spec.containers.[0].securityContext.capabilities.add=[\"NET_RAW\"]"
        ]
    },
    {
        "name": "Pod with drop ALL and add ALL is denied (loophole)",
        "template": "pod-drop-all.yaml",
        "expected": "fail",
        "field_change_list": [
            "spec.containers.[0].securityContext.capabilities.add=[\"ALL\"]"
        ]
    },
    {
        "name": "Pod with drop ALL and add lowercase net_raw is denied",
        "template": "pod-drop-all.yaml",
        "expected": "fail",
        "field_change_list": [
            "spec.containers.[0].securityContext.capabilities.add=[\"net_raw\"]"
        ]
    },
    {
        "name": "Pod with drop ALL and add CAP_NET_RAW is denied",
        "template": "pod-drop-all.yaml",
        "expected": "fail",
        "field_change_list": [
            "spec.containers.[0].securityContext.capabilities.add=[\"CAP_NET_RAW\"]"
        ]
    },
    {
        "name": "Deployment with drop ALL and add lowercase cap_net_raw is denied",
        "template": "deployment.yaml",
        "expected": "fail",
        "field_change_list": [
            "spec.template.spec.containers.[0].securityContext.capabilities.drop=[\"ALL\"]",
            "spec.template.spec.containers.[0].securityContext.capabilities.add=[\"cap_net_raw\"]"
        ]
    },
    {
        "name": "CronJob with drop ALL and add lowercase all is denied",
        "template": "cronjob.yaml",
        "expected": "fail",
        "field_change_list": [
            "spec.jobTemplate.spec.template.spec.containers.[0].securityContext.capabilities.drop=[\"ALL\"]",
            "spec.jobTemplate.spec.template.spec.containers.[0].securityContext.capabilities.add=[\"all\"]"
        ]
    },
    {
        "name": "Pod with drop ALL and add CAP_NET_BIND_SERVICE is allowed",
        "template": "pod-drop-all.yaml",
        "expected": "pass",
        "field_change_list": [
            "spec.containers.[0].securityContext.capabilities.add=[\"CAP_NET_BIND_SERVICE\"]"
        ]
    },
    {
        "name": "Pod with lowercase drop all is allowed",
        "template": "pod-drop-all.yaml",
        "expected": "pass",
        "field_change_list": [
            "spec.containers.[0].securityContext.capabilities.drop=[\"all\"]"
        ]
    },
    {
        "name": "Deployment with lowercase drop net_raw is allowed",
        "template": "deployment.yaml",
        "expected": "pass",
        "field_change_list": [
            "spec.template.spec.containers.[0].securityContext.capabilities.drop=[\"net_raw\"]"
        ]
    },
    {
        "name": "Pod with drop CAP_NET_RAW is denied, containerd does not drop that spelling",
        "template": "pod-drop-all.yaml",
        "expected": "fail",
        "field_change_list": [
            "spec.containers.[0].securityContext.capabilities.drop=[\"CAP_NET_RAW\"]"
        ]
    }
]
