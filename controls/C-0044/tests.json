[
    {
        "name": "Pod with container having hostPort blocked",
        "template": "pod.yaml",
        "expected": "fail",
        "field_change_list": [
            "spec.containers.[0].ports.[0].hostPort=2023"
        ]
    },
    {
        "name": "Pod with container not having hostPort allowed",
        "template": "pod.yaml",
        "expected": "pass",
        "field_change_list": [
        ]
    },
    {
        "name": "Pod having container with hostPort 0 is allowed",
        "template": "pod.yaml",
        "expected": "pass",
        "field_change_list": [
            "spec.containers.[0].ports.[0].hostPort=0"
        ]
    },
    {
        "name": "Deployment with container having hostPort blocked",
        "template": "deployment.yaml",
        "expected": "fail",
        "field_change_list": [
            "spec.template.spec.containers.[0].ports.[0].hostPort=2023"
        ]
    },
    {
        "name": "Deployment with container not having hostPort allowed",
        "template": "deployment.yaml",
        "expected": "pass",
        "field_change_list": [
        ]
    },
    {
        "name": "CronJob with container not having hostPort allowed",
        "template": "cronjob.yaml",
        "expected": "pass",
        "field_change_list": [
        ]
    },
    {
        "name": "CronJob with container having hostPort blocked",
        "template": "cronjob.yaml",
        "expected": "fail",
        "field_change_list": [
            "spec.jobTemplate.spec.template.spec.containers.[0].ports.[0].hostPort=2023"
        ]
    },
    {
        "name": "Pod having initContainer with hostPort is blocked",
        "template": "pod-with-init-container.yaml",
        "expected": "fail",
        "field_change_list": [
            "spec.initContainers.[0].ports.[0].containerPort=8080",
            "spec.initContainers.[0].ports.[0].hostPort=2023"
        ]
    },
    {
        "name": "Pod having initContainer without hostPort is allowed",
        "template": "pod-with-init-container.yaml",
        "expected": "pass",
        "field_change_list": [
            "spec.initContainers.[0].ports.[0].containerPort=8080"
        ]
    },
    {
        "name": "Deployment having initContainer with hostPort is blocked",
        "template": "deployment.yaml",
        "expected": "fail",
        "field_change_list": [
            "spec.template.spec.initContainers.[0].name=init",
            "spec.template.spec.initContainers.[0].image=alpine",
            "spec.template.spec.initContainers.[0].ports.[0].containerPort=8080",
            "spec.template.spec.initContainers.[0].ports.[0].hostPort=2023"
        ]
    },
    {
        "name": "Deployment having initContainer without hostPort is allowed",
        "template": "deployment.yaml",
        "expected": "pass",
        "field_change_list": [
            "spec.template.spec.initContainers.[0].name=init",
            "spec.template.spec.initContainers.[0].image=alpine",
            "spec.template.spec.initContainers.[0].ports.[0].containerPort=8080"
        ]
    },
    {
        "name": "CronJob having initContainer with hostPort is blocked",
        "template": "cronjob.yaml",
        "expected": "fail",
        "field_change_list": [
            "spec.jobTemplate.spec.template.spec.initContainers.[0].name=init",
            "spec.jobTemplate.spec.template.spec.initContainers.[0].image=alpine",
            "spec.jobTemplate.spec.template.spec.initContainers.[0].ports.[0].containerPort=8080",
            "spec.jobTemplate.spec.template.spec.initContainers.[0].ports.[0].hostPort=2023"
        ]
    },
    {
        "name": "CronJob having initContainer without hostPort is allowed",
        "template": "cronjob.yaml",
        "expected": "pass",
        "field_change_list": [
            "spec.jobTemplate.spec.template.spec.initContainers.[0].name=init",
            "spec.jobTemplate.spec.template.spec.initContainers.[0].image=alpine",
            "spec.jobTemplate.spec.template.spec.initContainers.[0].ports.[0].containerPort=8080"
        ]
    },
    {
        "name": "Pod having initContainer with hostPort 0 is allowed",
        "template": "pod-with-init-container.yaml",
        "expected": "pass",
        "field_change_list": [
            "spec.initContainers.[0].ports.[0].containerPort=8080",
            "spec.initContainers.[0].ports.[0].hostPort=0"
        ]
    },
    {
        "name": "Pod with hostNetwork and a container port but no hostPort is blocked, the apiserver defaults hostPort to the container port",
        "template": "pod.yaml",
        "expected": "fail",
        "field_change_list": [
            "spec.hostNetwork=true"
        ]
    },
    {
        "name": "Pod with hostNetwork and an explicit hostPort of 0 is blocked, zero is defaulted to the container port",
        "template": "pod.yaml",
        "expected": "fail",
        "field_change_list": [
            "spec.hostNetwork=true",
            "spec.containers.[0].ports.[0].hostPort=0"
        ]
    },
    {
        "name": "Pod with hostNetwork and no ports is allowed",
        "template": "pod.yaml",
        "expected": "pass",
        "field_change_list": [
            "spec.hostNetwork=true",
            "spec.containers.[0].ports=[]"
        ]
    },
    {
        "name": "Pod with hostNetwork false and a container port is allowed",
        "template": "pod.yaml",
        "expected": "pass",
        "field_change_list": [
            "spec.hostNetwork=false"
        ]
    },
    {
        "name": "Pod with hostNetwork and an initContainer port but no hostPort is blocked",
        "template": "pod-with-init-container.yaml",
        "expected": "fail",
        "field_change_list": [
            "spec.hostNetwork=true",
            "spec.initContainers.[0].ports.[0].containerPort=8080"
        ]
    },
    {
        "name": "Deployment with hostNetwork and a container port but no hostPort is allowed, a pod template is not defaulted",
        "template": "deployment.yaml",
        "expected": "pass",
        "field_change_list": [
            "spec.template.spec.hostNetwork=true"
        ]
    },
    {
        "name": "Pod with hostNetwork and a hostPort equal to the container port is blocked",
        "template": "pod.yaml",
        "expected": "fail",
        "field_change_list": [
            "spec.hostNetwork=true",
            "spec.containers.[0].ports.[0].hostPort=8086"
        ]
    }
]